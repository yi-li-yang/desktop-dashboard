{
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/usage-guard/usage_guard.py statusline",
    "refreshInterval": 30
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/usage-guard/usage_guard.py prompt" } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "python3 ~/.claude/usage-guard/usage_guard.py tool" } ] }
    ]
  },
  "env": {
    "USAGE_GUARD_CAP_USD": "1.00",
    "USAGE_GUARD_OVERRIDE": "!spill"
  }
}
